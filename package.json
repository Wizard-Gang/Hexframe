{
  "name": "hexframe",
  "version": "0.7.9",
  "private": true,
  "license": "MIT",
  "description": "Deterministic browser fighting-game training lab.",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "26.x",
    "npm": "11.x"
  },
  "scripts": {
    "build": "vite build && node scripts/version-stamp.mjs Hexframe dist",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs --skip-build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "vitest run tests/content",
    "secrets:push": "node scripts/sync-secrets.mjs",
    "deploy": "node scripts/deploy.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run validate:content"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.125.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260820.1": true,
    "fsevents@2.3.3": true
  }
}

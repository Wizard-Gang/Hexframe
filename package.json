{
  "name": "hexframe",
  "version": "0.7.9",
  "private": true,
  "license": "MIT",
  "description": "Deterministic browser fighting-game training lab.",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "26.x",
    "npm": "11.x"
  },
  "scripts": {
    "build": "vite build && node scripts/version-stamp.mjs Hexframe dist",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs --skip-build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "vitest run tests/content",
    "validate:documents": "node scripts/validate-rendered-documents.mjs",
    "check:history": "node scripts/check-history.mjs",
    "check": "npm run check:history && npm run test:patch-integrity && npm run check:patch-integrity && npm run typecheck && npm run test && npm run test:dev-secrets && npm run test:dev-process-ownership && npm run test:dev-lifecycle && npm run test:dependency-advisory && npm run test:version-stamp && npm run test:build-identity && npm run test:github-settings && npm run build && npm run validate:documents && npm run validate:presentation-security && npm run validate:release-boundary && npm run validate:documentation-authority && npm run validate:content",
    "validate:presentation-security": "node scripts/validate-presentation-security.mjs",
    "deploy:dry-run": "node scripts/deploy.mjs",
    "validate:release-boundary": "node scripts/validate-release-boundary.mjs",
    "validate:documentation-authority": "node scripts/validate-documentation-authority.mjs",
    "test:github-settings": "node --test scripts/github-repository-settings-cases.mjs",
    "verify:github-settings": "node scripts/verify-github-repository-settings.mjs",
    "apply:github-settings": "node scripts/apply-github-repository-settings.mjs",
    "test:dev-secrets": "node --test scripts/dev-secret-cases.mjs",
    "test:dev-process-ownership": "node --test scripts/dev-process-ownership-cases.mjs",
    "test:dev-lifecycle": "node --test scripts/dev-lifecycle-cases.mjs",
    "test:dev-smoke": "node scripts/dev-smoke.mjs",
    "test:dependency-advisory": "node --test scripts/dependency-advisory-cases.mjs",
    "audit:dependencies": "node scripts/dependency-advisory.mjs",
    "test:version-stamp": "node --test scripts/version-stamp-cases.mjs",
    "test:build-identity": "node scripts/build-identity-cases.mjs",
    "test:patch-integrity": "node --test scripts/patch-integrity-cases.mjs",
    "check:patch-integrity": "node scripts/check-patch-integrity.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260921.1": true
  }
}

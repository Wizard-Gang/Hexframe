{
  "name": "hexframe",
  "version": "0.9.0",
  "private": true,
  "license": "MIT",
  "description": "Deterministic browser fighting-game training lab.",
  "type": "module",
  "packageManager": "npm@12.1.0",
  "engines": {
    "node": "26.x",
    "npm": "12.x"
  },
  "scripts": {
    "build": "vite build && node scripts/version-stamp.mjs Hexframe dist",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:documents": "node scripts/validate-rendered-documents.mjs",
    "check:history": "node scripts/check-history.mjs",
    "test:plan-queue": "node scripts/check-portfolio-contract.mjs",
    "check:public-secrets": "node scripts/check-public-secrets.mjs",
    "test:public-secrets": "node --test scripts/public-secret-cases.mjs",
    "check": "npm run test:plan-queue && npm run check:history && npm run check:platform && npm run test:public-secrets && npm run check:public-secrets && npm run test:patch-integrity && npm run check:patch-integrity && npm run typecheck && npm run test && npm run test:dependency-advisory && npm run test:release-workflow && npm run test:release-cutter && npm run test:release-identity && npm run test:version-stamp && npm run test:build-identity && npm run test:github-settings && npm run build && npm run validate:documents && npm run validate:presentation-security && npm run validate:release-boundary && npm run validate:documentation-authority",
    "validate:presentation-security": "node scripts/validate-presentation-security.mjs",
    "validate:release-boundary": "node scripts/validate-release-boundary.mjs",
    "validate:documentation-authority": "node scripts/validate-documentation-authority.mjs",
    "test:github-settings": "node --test scripts/github-repository-settings-cases.mjs",
    "verify:github-settings": "node scripts/verify-github-repository-settings.mjs",
    "apply:github-settings": "node scripts/apply-github-repository-settings.mjs",
    "test:dependency-advisory": "node --test scripts/dependency-advisory-cases.mjs",
    "audit:dependencies": "node scripts/dependency-advisory.mjs",
    "security:dependency-advisories": "npm run audit:dependencies",
    "test:release-workflow": "node --test scripts/release-workflow-cases.mjs",
    "test:release-cutter": "node --test scripts/release-cutter-cases.mjs",
    "test:release-identity": "node --test scripts/release-identity-cases.mjs",
    "verify:release-identity": "node scripts/release-identity.mjs",
    "test:version-stamp": "node --test scripts/version-stamp-cases.mjs",
    "test:build-identity": "node scripts/build-identity-cases.mjs",
    "test:patch-integrity": "node --test scripts/patch-integrity-cases.mjs",
    "check:patch-integrity": "node scripts/check-patch-integrity.mjs",
    "generate:worker-release": "node scripts/generate-worker-release.mjs",
    "pretypecheck": "npm run generate:worker-release",
    "pretest": "npm run generate:worker-release",
    "prebuild": "npm run generate:worker-release",
    "check:platform": "node platform/conformance/cli.mjs pin && node platform/conformance/cli.mjs wrangler --worker hexframe"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261001.1",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.147.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20261001.1": true
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    }
  },
  "imports": {
    "#wg-edge": {
      "types": "./platform/wg-edge/index.d.ts",
      "default": "./platform/wg-edge/index.mjs"
    }
  }
}

{
  "name": "hexframe",
  "version": "0.7.9",
  "private": true,
  "license": "MIT",
  "description": "Deterministic browser fighting-game training lab.",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "26.x",
    "npm": "11.x"
  },
  "scripts": {
    "build": "vite build && node scripts/version-stamp.mjs Hexframe dist",
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/dev.mjs --skip-build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:content": "vitest run tests/content",
    "validate:documents": "node scripts/validate-rendered-documents.mjs",
    "check:history": "node scripts/check-history.mjs",
    "check": "npm run check:history && npm run typecheck && npm run test && npm run build && npm run validate:documents && npm run validate:presentation-security && npm run validate:release-boundary && npm run validate:content",
    "validate:presentation-security": "node scripts/validate-presentation-security.mjs",
    "deploy:dry-run": "node scripts/deploy.mjs",
    "validate:release-boundary": "node scripts/validate-release-boundary.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260823.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "wrangler": "^4.125.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "workerd@1.20260820.1": true
  }
}

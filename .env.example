# Hexframe — local credential template.
#
# Copy this file to the repository-root `.env`. Local scripts read that one file;
# `npm run dev` writes only the required admin values to ignored `.dev.vars` with
# owner-only permissions before Wrangler starts. `.env` is ignored by git.
#
#   cp .env.example .env
#
# `npm run secrets:push` copies these into production as Cloudflare Worker secrets.
#
# They are read only inside the Worker. None of them is ever sent to the browser, and
# none of them may appear in wrangler.jsonc, in client code, or in any built asset.

ADMIN_USERNAME=
ADMIN_PASSWORD=
# Long random string used to sign the session cookie. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Cloudflare account id, used by `npm run deploy`. It is kept out of wrangler.jsonc so
# the root .env remains the single environment source for this repository.
CLOUDFLARE_ACCOUNT_ID=

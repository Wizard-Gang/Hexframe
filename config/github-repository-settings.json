{
  "repository": "Wizard-Gang/Hexframe",
  "defaultBranch": "main",
  "mergeMethods": {
    "mergeCommit": false,
    "squash": true,
    "rebase": false
  },
  "deleteBranchOnMerge": true,
  "requiredStatusChecks": ["verify", "change-id", "secrets"],
  "rulesets": [
    {
      "name": "main-protection",
      "target": "branch",
      "enforcement": "active",
      "include": ["refs/heads/main"],
      "bypassActors": [],
      "requireBranchUpToDate": true,
      "rules": ["deletion", "non_fast_forward", "pull_request", "required_status_checks"]
    },
    {
      "name": "release-tag-immutability",
      "target": "tag",
      "enforcement": "active",
      "include": ["refs/tags/v*"],
      "bypassActors": [],
      "rules": ["deletion", "update"]
    }
  ]
}

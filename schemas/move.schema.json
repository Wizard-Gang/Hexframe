{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hexframe.local/schemas/move.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "key", "duration", "startup", "active", "recovery", "requiresCrouch", "airOk", "hitboxes", "hurtboxWindows", "invulWindows", "armorWindows", "movement", "cancelWindows"],
  "properties": {
    "id": { "type": "integer", "minimum": 0 },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" } },
    "description": { "type": "string", "minLength": 1 },
    "duration": { "type": "integer", "minimum": 1 },
    "startup": { "type": "integer", "minimum": 0 },
    "active": { "type": "integer", "minimum": 0 },
    "recovery": { "type": "integer", "minimum": 0 },
    "requiresCrouch": { "type": "boolean" },
    "airOk": { "type": "boolean" },
    "hitboxes": { "type": "array", "items": { "$ref": "#/definitions/hitbox" } },
    "hurtboxWindows": { "type": "array", "items": { "$ref": "#/definitions/hurtboxWindow" } },
    "invulWindows": { "type": "array", "items": { "$ref": "#/definitions/invulWindow" } },
    "armorWindows": { "type": "array", "items": { "$ref": "#/definitions/armorWindow" } },
    "movement": { "type": "array", "items": { "$ref": "#/definitions/movement" } },
    "cancelWindows": { "type": "array", "items": { "$ref": "#/definitions/cancelWindow" } }
  },
  "definitions": {
    "box": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "w", "h"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "w": { "type": "number", "exclusiveMinimum": 0 }, "h": { "type": "number", "exclusiveMinimum": 0 } }
    },
    "window": {
      "type": "object", "required": ["startFrame", "endFrame"],
      "properties": { "startFrame": { "type": "integer", "minimum": 0 }, "endFrame": { "type": "integer", "minimum": 0 } }
    },
    "hitbox": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "box", "startFrame", "endFrame", "level", "damage", "hitstun", "blockstun", "hitstopAttacker", "hitstopDefender", "pushbackHitAttacker", "pushbackHitDefender", "pushbackBlockAttacker", "pushbackBlockDefender"],
      "properties": {
        "id": { "type": "integer", "minimum": 0, "maximum": 30 }, "box": { "$ref": "#/definitions/box" },
        "startFrame": { "type": "integer", "minimum": 0 }, "endFrame": { "type": "integer", "minimum": 0 },
        "level": { "enum": ["overhead", "mid", "low"] }, "damage": { "type": "integer", "minimum": 0 },
        "hitstun": { "type": "integer", "minimum": 0 }, "blockstun": { "type": "integer", "minimum": 0 },
        "hitstopAttacker": { "type": "integer", "minimum": 0 }, "hitstopDefender": { "type": "integer", "minimum": 0 },
        "pushbackHitAttacker": { "type": "number" }, "pushbackHitDefender": { "type": "number" },
        "pushbackBlockAttacker": { "type": "number" }, "pushbackBlockDefender": { "type": "number" },
        "launchVelocityY": { "type": "number", "minimum": 0 }
      }
    },
    "hurtboxWindow": {
      "type": "object", "additionalProperties": false, "required": ["startFrame", "endFrame", "boxes"],
      "properties": { "startFrame": { "type": "integer", "minimum": 0 }, "endFrame": { "type": "integer", "minimum": 0 }, "boxes": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/box" } } }
    },
    "invulWindow": {
      "type": "object", "additionalProperties": false, "required": ["startFrame", "endFrame", "kind"],
      "properties": { "startFrame": { "type": "integer", "minimum": 0 }, "endFrame": { "type": "integer", "minimum": 0 }, "kind": { "enum": ["full", "strike", "throw"] } }
    },
    "armorWindow": {
      "type": "object", "additionalProperties": false, "required": ["startFrame", "endFrame", "hits"],
      "properties": { "startFrame": { "type": "integer", "minimum": 0 }, "endFrame": { "type": "integer", "minimum": 0 }, "hits": { "type": "integer", "minimum": 1 } }
    },
    "movement": {
      "type": "object", "additionalProperties": false, "required": ["frame", "vx", "vy"],
      "properties": { "frame": { "type": "integer", "minimum": 0 }, "vx": { "type": "number" }, "vy": { "type": "number" } }
    },
    "cancelWindow": {
      "type": "object", "additionalProperties": false, "required": ["startFrame", "endFrame", "into", "onHitOnly"],
      "properties": { "startFrame": { "type": "integer", "minimum": 0 }, "endFrame": { "type": "integer", "minimum": 0 }, "into": { "type": "array", "items": { "type": "integer", "minimum": 0 } }, "onHitOnly": { "type": "boolean" } }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hexframe.local/schemas/character.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "health", "walkForwardSpeed", "walkBackwardSpeed", "jumpVelocityY", "jumpVelocityXForward", "jumpVelocityXBackward", "jumpSquatFrames", "landingFrames", "gravity", "groundFriction", "pushboxStand", "pushboxCrouch", "pushboxAir", "hurtboxesStand", "hurtboxesCrouch", "hurtboxesAir", "commands"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
    "name": { "type": "string", "minLength": 1 },
    "health": { "type": "integer", "minimum": 1 },
    "walkForwardSpeed": { "type": "number", "minimum": 0 },
    "walkBackwardSpeed": { "type": "number", "minimum": 0 },
    "jumpVelocityY": { "type": "number", "exclusiveMinimum": 0 },
    "jumpVelocityXForward": { "type": "number" },
    "jumpVelocityXBackward": { "type": "number" },
    "jumpSquatFrames": { "type": "integer", "minimum": 0 },
    "landingFrames": { "type": "integer", "minimum": 0 },
    "gravity": { "type": "number", "exclusiveMinimum": 0 },
    "groundFriction": { "type": "number", "minimum": 0 },
    "pushboxStand": { "$ref": "#/definitions/box" },
    "pushboxCrouch": { "$ref": "#/definitions/box" },
    "pushboxAir": { "$ref": "#/definitions/box" },
    "hurtboxesStand": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/box" } },
    "hurtboxesCrouch": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/box" } },
    "hurtboxesAir": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/box" } },
    "commands": { "type": "array", "items": { "$ref": "#/definitions/command" } }
  },
  "definitions": {
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number" }, "y": { "type": "number" },
        "w": { "type": "number", "exclusiveMinimum": 0 }, "h": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moveId", "buttons", "motion", "motionWindow", "requiresCrouch", "requiresAir", "priority"],
      "properties": {
        "moveId": { "type": "integer", "minimum": 0 },
        "buttons": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["light", "medium", "heavy", "throw", "action1", "action2", "action3", "action4", "action5", "action6", "action7", "action8", "action9", "action10", "action11", "action12", "action13", "action14", "action15", "action16"] } },
        "motion": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 9 } },
        "motionWindow": { "type": "integer", "minimum": 0 },
        "requiresCrouch": { "type": "boolean" },
        "requiresAir": { "type": "boolean" },
        "priority": { "type": "integer" }
      }
    }
  }
}
